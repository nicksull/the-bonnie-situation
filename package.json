{
  "name": "the-bonnie-situation",
  "private": true,
  "version": "1.3.0",
  "description": "DataViews-based admin for The Bonnie Situation plugin.",
  "scripts": {
    "build": "wp-scripts build src/index.js src/settings.js",
    "start": "wp-scripts start src/index.js src/settings.js",
    "plugin-zip": "wp-scripts plugin-zip",
    "bump": "node bin/bump-version.js",
    "test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/the-bonnie-situation vendor/bin/phpunit",
    "test:php:setup": "wp-env run tests-cli --env-cwd=wp-content/plugins/the-bonnie-situation composer install --no-interaction"
  },
  "devDependencies": {
    "@wordpress/dataviews": "^4.0.0",
    "@wordpress/env": "^10.39.0",
    "@wordpress/scripts": "^30.0.0"
  }
}
